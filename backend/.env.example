PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/jobkhojoai
JWT_SECRET=replace_this_with_a_long_random_string
ADMIN_EMAIL=admin@jobkhojoai.com
ADMIN_PASSWORD=choose_a_strong_password
CLIENT_URL=http://localhost:5173

# Free API key from https://aistudio.google.com/apikey — powers the "Ask AI" chat widget
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Job alert email delivery (Resend)
RESEND_API_KEY=
MAIL_FROM=hello@jobkhojoai.com
# Creator support notification recipient (uses the same Resend configuration)
SUPPORT_EMAIL=hello@jobkhojoai.com
PUBLIC_SITE_URL=https://jobkhojoai.com
API_PUBLIC_URL=https://jobkhojoai-backend.onrender.com/api
DIGEST_TIME_ZONE=Asia/Kolkata
DIGEST_HOUR=9
GOOGLE_CLIENT_ID=
